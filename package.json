{
  "name": "brainstorming",
  "version": "1.0.0",
  "description": "Evidence-backed technical research pipeline for Claude Code (plugin). Scripts here are for developing and testing the plugin.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:scripts": "node scripts/check-scripts.js",
    "check-syntax": "node scripts/check-scripts.js",
    "test": "node --test test/scripts.test.js",
    "validate": "npm run check:scripts && npm run topic-validate:all && npm run validate-pipeline-state && npm run validate:schemas && npm run lint:agents && npm run check-hygiene && npm run check-settings-hygiene:strict && npm run check-weakened-cycle:strict",
    "check-hygiene": "node scripts/check-hygiene.js --quiet",
    "check-hygiene:report": "node scripts/check-hygiene.js --write",
    "preflight:all": "npm run validate && npm run check-staleness -- --json && npm run claims:check:strict && npm test",
    "preflight:network": "node scripts/verify-citations.js --all --concurrency 5 --cache --cache-ttl-days 7",
    "security:secrets": "node scripts/secret-scan.js",
    "normalize-encoding": "node scripts/normalize-encoding.js --write --all",
    "hygiene:encoding": "node scripts/normalize-encoding.js --check --all",
    "release:check": "npm run hygiene:encoding && npm run preflight:all && npm run security:secrets && npm run index:leadership && npm run dashboard && npm run trend-report",
    "validate:schemas": "node scripts/validate-schemas.js",
    "validate:manifests": "node scripts/validate-manifests.js",
    "context-impact": "node scripts/context-impact-report.js",
    "context-impact:write": "node scripts/context-impact-report.js --write",
    "index:leadership": "node scripts/generate-leadership-index.js",
    "dashboard": "node scripts/generate-dashboard.js",
    "claims:check": "node scripts/claim-support-check.js --all",
    "claims:check:strict": "node scripts/claim-support-check.js --all --strict",
    "trend-report": "node scripts/trend-report.js",
    "regenerate-index": "node scripts/regenerate-index.js",
    "regenerate-index-dry": "node scripts/regenerate-index.js --dry-run",
    "validate-pipeline-state": "node scripts/validate-pipeline-state.js",
    "validate-pipeline-state:write": "node scripts/validate-pipeline-state.js --write",
    "validate-pipeline-state:repair": "node scripts/validate-pipeline-state.js --repair --write",
    "bench-report": "node scripts/bench-report.js",
    "verify-citations": "node scripts/verify-citations.js",
    "verify-citations:all": "node scripts/verify-citations.js --all",
    "check-staleness": "node scripts/check-staleness.js",
    "check-staleness:report": "node scripts/check-staleness.js --write",
    "bench-diff": "node scripts/bench-diff.js",
    "bench-diff:list": "node scripts/bench-diff.js --list",
    "topic-init": "node scripts/topic-init.js",
    "topic-init:dry": "node scripts/topic-init.js --dry-run",
    "archive-topic": "node scripts/archive-topic.js",
    "archive-topic:list": "node scripts/archive-topic.js list",
    "topic-validate": "node scripts/topic-validate.js",
    "topic-validate:all": "node scripts/topic-validate.js --all",
    "pipeline-preflight": "node scripts/pipeline-preflight.js",
    "lint:agents": "node scripts/lint-agents.js",
    "diagnose-run": "node scripts/diagnose-run.js",
    "diagnose-run:all": "node scripts/diagnose-run.js --all",
    "check-publisher-gate": "node scripts/check-publisher-gate.js",
    "check-settings-hygiene": "node scripts/check-settings-hygiene.js",
    "check-settings-hygiene:strict": "node scripts/check-settings-hygiene.js --strict",
    "check-weakened-cycle": "node scripts/check-weakened-cycle.js",
    "check-weakened-cycle:strict": "node scripts/check-weakened-cycle.js --strict",
    "learn-from-runs": "node scripts/learn-from-runs.js",
    "log-pipeline-error": "node scripts/log-pipeline-error.js",
    "prune-citation-cache": "node scripts/prune-citation-cache.js",
    "prune-citation-cache:dry": "node scripts/prune-citation-cache.js --dry-run"
  }
}
